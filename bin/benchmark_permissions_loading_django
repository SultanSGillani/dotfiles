#!/usr/bin/env python
"""Benchmark script for measuring permissions loading performance in Django."""
import os
import time
import numpy

# temp file for benchmarking


all_times = []


def timeit(method):

    def timed(*args, **kw):
        ts = time.time()

        result = method(*args, **kw)
        te = time.time()
        all_times.append(te - ts)

        print(all_times)
        print(numpy.mean(all_times))
        return result

    return timed


def create_new_db():
    """Create a new database and run migrations."""
    os.system("mysqladmin -u root drop DATABASE_NAME -f")
    os.system("mysqladmin -u root create DATABASE_NAME -f")
    os.system("./manage.py syncdb")
    os.system("./manage.py migrate")


@timeit
def load_new_perms():
    """Load permissions into the database."""
    os.system("./manage.py LOAD_PERMS_COMMAND")


if __name__ == "__main__":
    n = 0
    all_times = []
    while n < 10:
        create_new_db()
        load_new_perms()
        n += 1
