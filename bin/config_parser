#!/usr/bin/env python
"""
This is my own implementation of standard library ConfigParser module
It parses .ini file and generates a configuration object
"""
import re


FORMAT_RE = r'.*%\([^\)]+\)[sd].*'
SECTION_RE = r'\[([^\[\]]+)\]'
OPTION_RE = r'(.*)=(.*)'
COMMENT_RE = r'^;.*'


class InvalidConfig(Exception):
    """Exception raised for invalid configuration files."""


def _is_format_str(s):
    regex = re.compile(FORMAT_RE)
    return regex.match(s)


def _parse_config_file(f):
    sections = {}
    current_section = None
    current_options = {}

    section_re = re.compile(SECTION_RE)
    option_re = re.compile(OPTION_RE)
    comment_re = re.compile(COMMENT_RE)

    for line in f:
        line = line.strip()

        if not line:
            continue
        if comment_re.match(line):
            continue

        mo = section_re.match(line)
        if mo:
            if current_section:
                sections[current_section] = current_options
            current_section = mo.group(1)
            current_options = {}
        else:
            mo1 = option_re.match(line)
            if mo1:
                if not current_section:
                    raise InvalidConfig("Invalid config file")
                key, value = mo1.group(1).strip(), mo1.group(2).strip()
                current_options[key] = value
            else:
                raise InvalidConfig("Invalid config file")
    if current_section:
        sections[current_section] = current_options
    return sections


class ConfigParser:
    """Configuration file parser for .ini files with interpolation support."""

    def __init__(self, defaults=None):
        """
        create the parser and specify a dictionary of intrinsic defaults.  The
        keys must be strings, the values must be appropriate for %()s string
        interpolation.  Note that `__name__' is always an intrinsic default;
        its value is the section's name.
        """
        self._defaults = defaults if defaults else {}
        self._sections = {}

    def sections(self):
        """Return all the configuration section names."""
        return self._sections.keys()

    def has_section(self, section):
        """Check if a section exists in the configuration."""
        return section in self._sections

    def has_option(self, section, option):
        """Check if an option exists within a given section."""
        return self.has_section(section) and option in self._sections[section]

    def options(self, section):
        """Return a list of option names for the given section."""
        if not self.has_section(section):
            return []
        return list(self._sections[section].keys())

    def read(self, filenames):
        """
        read and parse the list of named configuration files, given by
        name.  A single filename is also allowed.  Non-existing files
        are ignored.  Return list of successfully read files.
        """
        if isinstance(filenames, str):
            filenames = [filenames]
        for fname in filenames:
            try:
                with open(fname, 'r', encoding='utf-8') as f:
                    self.readfp(f)
            except IOError:
                print(f"Fail to open file {fname}, ignored")
            except InvalidConfig:
                print(f"Invalid config file {fname}, ignored")

    def readfp(self, fp):
        """
        read and parse one configuration file, given as a file object.
        The filename defaults to fp.name; it is only used in error
        messages (if fp has no `name' attribute, the string `<???>' is used).
        """
        secs = _parse_config_file(fp)
        self._sections.update(secs)

    def parse_item(self, section, _key, val, extra_vars=None):
        """Parse a configuration value, applying interpolation if needed."""
        # Now support only 1 level of interpolation
        if not _is_format_str(val):
            return val
        # first try extra_vars, then defaults, then section
        if extra_vars:
            try:
                return val % extra_vars
            except KeyError:
                pass
        try:
            newval = val % self._defaults
        except KeyError:
            try:
                newval = val % self._sections[section]
            except KeyError:
                newval = val
        return newval

    def get(self, section, option, raw=False, extra_vars=None):
        """Return the value for the given option in the specified section."""
        if not self.has_section(section):
            return None
        sec = self._sections[section]
        if option not in sec:
            return None
        if raw:
            return sec[option]
        return self.parse_item(section, option, sec[option], extra_vars)

    def getint(self, section, option):
        """Return the value for the given option in the specified section as an integer."""
        val = self.get(section, option)
        if val is None:
            raise KeyError(f"Option '{option}' not found in section '{section}'")
        return int(val)

    def getfloat(self, section, option):
        """Return the value for the given option in the specified section as a float."""
        val = self.get(section, option)
        if val is None:
            raise KeyError(f"Option '{option}' not found in section '{section}'")
        return float(val)

    def getboolean(self, section, option):
        """Return the value for the given option in the specified section as a boolean."""
        val = self.get(section, option)
        if val is None:
            raise KeyError(f"Option '{option}' not found in section '{section}'")
        val = val.strip()
        if val.lower() in ["0", "false", "no", "off"]:
            return False
        elif val.lower() in ["1", "true", "yes", "on"]:
            return True
        else:
            raise ValueError("Invalid boolean option")

    def items(self, section, raw=False, vars=None):
        """Return a list of (name, value) pairs for each option in the given section."""
        try:
            d = self._sections[section].copy()
        except KeyError:
            d = {}
        d.update(self._defaults)
        return d.items()

    def remove_option(self, section, option):
        """Remove the specified option from the given section."""
        if self.has_option(section, option):
            del self._sections[section][option]

    def set(self, section, option, value):
        """Set the value for the given option in the specified section."""
        if self.has_section(section):
            self._sections[section][option] = value

    def write(self, fp):
        """Write the configuration state in .ini format to the given file object."""
        for section, options in self._sections.items():
            fp.write(f"[{section}]\n")
            for key, value in options.items():
                fp.write(f"{key} = {value}\n")
            fp.write("\n")
