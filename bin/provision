#!/usr/bin/env bash
set -o errexit
set -o pipefail
set -o nounset

ZSH="${HOME}/dotfiles"
PLAYBOOK="${ZSH}/dotfiles.yml"
HOSTS="${ZSH}/inventory.yml"

cd "${ZSH}"

# shellcheck source=/dev/null
[[ -f ~/.secrets ]] && source ~/.secrets

HOST_OS="$(uname)"

if [[ ! -d "${HOME}/.ansible/collections/ansible_collections/community/general" ]]; then
  echo "Installing ansible-galaxy collection for community.general"
  ansible-galaxy collection install community.general
fi

if [[ ! -f ~/.vault_password.txt ]]; then
  echo "please add your vault password file (~/.vault_password.txt)"
  exit 1
fi

if [[ "${HOST_OS}" != "Darwin" && "${HOST_OS}" != "Linux" ]]; then
  echo "Unknown host OS: ${HOST_OS}"
  exit 1
fi

echo "Running dotfiles Playbook for ${HOST_OS}"

if [[ $# -eq 0 ]]; then
  ansible-playbook -i "${HOSTS}" "${PLAYBOOK}" -K \
    --vault-password-file ~/.vault_password.txt
else
  TAGS="$(IFS=,; echo "$*")"
  ansible-playbook -i "${HOSTS}" "${PLAYBOOK}" -K \
    --vault-password-file ~/.vault_password.txt \
    --tags "${TAGS}"
fi

