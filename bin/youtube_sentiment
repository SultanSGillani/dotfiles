#!/usr/bin/env python
"""
Example usage:

$ python 31_youtube_sentiment.py https://www.youtube.com/watch?v=_vrAjAHhUsA
"""
import sys
import requests
from bs4 import BeautifulSoup


def get_arguments():
    """Parse and return command-line arguments."""
    if len(sys.argv) == 2:
        return sys.argv[1]
    print('Specify at least 1 argument')
    sys.exit()


def get_comments(url):
    """Fetch YouTube comments for the given video URL."""
    base = 'https://plus.googleapis.com/u/0/_/widget/render/comments'
    params = '?first_party_property=YOUTUBE&href='
    html = requests.get(base + params + url)
    soup = BeautifulSoup(html.text, 'html.parser')
    return [
        comment.string
        for comment in soup.find_all('div', attrs={'class': 'Ct'})
    ]


def calculate_sentiment(comments):
    """Calculate positive and negative sentiment scores from comments."""
    positive = 0
    negative = 0
    negative_words = [
        'hate', 'hated', 'dislike', 'disliked',
        'awful', 'terrible', 'bad', 'painful',
        'worst', 'suck', 'rubbish', 'sad', 'sodding'
    ]
    positive_words = [
        'love', 'loved', 'like', 'liked',
        'awesome', 'amazing', 'good', 'great',
        'excellent', 'brilliant', 'cool'
    ]
    for comment in comments:
        if comment is None:
            continue
        for word in comment.split(' '):
            if word in negative_words:
                negative += 1
            if word in positive_words:
                positive += 1
    return {'positive': positive, 'negative': negative}


def main():
    """Run the YouTube sentiment analysis."""
    url = get_arguments()
    if url:
        comments = get_comments(url)
        if len(comments) <= 0:
            print('This video has no comments.')
            sys.exit()
        sentiment = calculate_sentiment(comments)
        positive_score = sentiment['positive']
        negative_score = sentiment['negative']
        total_score = positive_score + negative_score
        if positive_score > negative_score:
            print('This video is generally positive:')
            print(f'{positive_score} positive / {total_score} total hits')
        elif negative_score > positive_score:
            print('This video is generally negative:')
            print(f'{negative_score} negative / {total_score} total hits')
        else:
            print('This video is mutual:')
            print(f'{positive_score} positive {negative_score} negative')
    else:
        print('No url supplied')


if __name__ == '__main__':
    main()
